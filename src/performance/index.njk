{% from "macros/picture.njk" import responsivePicture with context %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "Performance e acompanhamento médico em Belém",
  "url": "{{ site.url }}/performance/",
  "about": { "@type": "MedicalCondition", "name": "Condicionamento físico e recuperação" },
  "lastReviewed": "2026-09-01",
  "reviewedBy": { "@type": "Physician", "name": "Dr. Mauricio Neiva" }
}
